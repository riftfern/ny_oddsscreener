# Your API key from https://the-odds-api.com
THE_ODDS_API_KEY=your_key_here

# Set to true to use mock data instead of The Odds API
# This is useful for development to avoid using API credits
USE_MOCK_DATA=true

# In-memory cache TTL for odds fetches (ms). EV/arb must hit this cache
# instead of re-fetching every sport, or the 20K credit plan dies on day one.
ODDS_CACHE_TTL_MS=45000

# Default regions for the Edge screen (each region is one credit unit).
# 'eu' is included so Pinnacle (the fair line) arrives.
# Do NOT add 'us_ex' here — exchanges are a Pro-only 4th unit (see ODDS_EXCHANGE_REGIONS).
ODDS_REGIONS=us,us2,eu

# Regions used by the Pro exchanges screen (Kalshi / Polymarket). Fetched
# separately via /api/odds/exchanges so Edge users don't pay for it.
ODDS_EXCHANGE_REGIONS=us_ex

# Auth / billing
# Set REQUIRE_AUTH=false and DEV_PLAN=pro to review the app without Clerk/Stripe keys.
# In production, REQUIRE_AUTH=true, set CLERK_SECRET_KEY, and configure Stripe below.
REQUIRE_AUTH=false
DEV_PLAN=pro

# Clerk (backend). sk_test_… from `clerk env pull`. Never expose to the client.
CLERK_SECRET_KEY=

# Stripe (Dashboard → Product catalog: Edge $19/mo, Pro $49/mo)
# Webhook URL: POST /api/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
# Local forwarding: stripe listen --forward-to localhost:3001/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EDGE=
STRIPE_PRICE_PRO=

# Frontend URL for Stripe checkout redirects (success → /app?checkout=success)
# Production: https://scharfedge.com
FRONTEND_URL=http://localhost:3000

# Telegram alerts (Pro). Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free-tier odds delay (ms). Edge/Pro see live; free sees the last snapshot.
FREE_ODDS_DELAY_MS=900000

# Set to false in tests to skip live Gamma/Kalshi fetches.
NATIVE_EXCHANGES=true

# Optional OddsPapi sharp fallback when The Odds API has no Pinnacle line.
# Set SHARP_FALLBACK=oddspapi and provide ODDS_PAPI_KEY to enable.
# Leave SHARP_FALLBACK empty to stay on The Odds API only.
ODDS_PAPI_KEY=
SHARP_FALLBACK=

# Append-only odds snapshots for future CLV analysis.
# Set SNAPSHOTS=true to enable. Disabled automatically in mock mode.
SNAPSHOTS=false
SNAPSHOT_PATH=
