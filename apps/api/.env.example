# Your API key from https://the-odds-api.com
THE_ODDS_API_KEY=your_key_here

# Set to true to use mock data instead of The Odds API
# This is useful for development to avoid using API credits
USE_MOCK_DATA=true

# In-memory cache TTL for odds fetches (ms). EV/arb must hit this cache
# instead of re-fetching every sport, or the 20K credit plan dies on day one.
ODDS_CACHE_TTL_MS=45000

# Default regions for the Edge screen (each region is one credit unit).
# 'eu' is included so Pinnacle (the fair line) arrives.
# Do NOT add 'us_ex' here — exchanges are a Pro-only 4th unit (see ODDS_EXCHANGE_REGIONS).
ODDS_REGIONS=us,us2,eu

# Regions used by the Pro exchanges screen (Kalshi / Polymarket). Fetched
# separately via /api/odds/exchanges so Edge users don't pay for it.
ODDS_EXCHANGE_REGIONS=us_ex

# Auth / billing
# Set REQUIRE_AUTH=false and DEV_PLAN=pro to review the app without Clerk/Stripe keys.
# In production, REQUIRE_AUTH=true, set CLERK_SECRET_KEY, and configure Stripe below.
REQUIRE_AUTH=false
DEV_PLAN=pro

# Clerk (backend)
CLERK_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EDGE=
STRIPE_PRICE_PRO=

# Frontend URL for Stripe checkout redirects
FRONTEND_URL=http://localhost:3000

# Telegram alerts (Pro). Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
