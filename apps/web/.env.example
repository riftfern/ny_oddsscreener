# Backend API URL (leave empty to use the same origin)
VITE_API_URL=

# Clerk publishable key (pk_test_… from `clerk env pull`).
# If set, Sign in / Sign up / UserButton appear. /app only requires sign-in when VITE_REQUIRE_AUTH=true.
VITE_CLERK_PUBLISHABLE_KEY=

# Set to true to require Clerk authentication for /app routes (production).
# Keep false on the laptop so the unsigned phone board still opens.
VITE_REQUIRE_AUTH=false

# Plan to inject when VITE_REQUIRE_AUTH=false. Options: free, edge, pro.
VITE_DEV_PLAN=pro
