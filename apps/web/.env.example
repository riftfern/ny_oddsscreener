# Backend API URL (leave empty to use the same origin)
VITE_API_URL=

# Clerk publishable key. If set and VITE_REQUIRE_AUTH=true, /app requires sign-in.
VITE_CLERK_PUBLISHABLE_KEY=

# Set to true to require Clerk authentication for /app routes.
# Set to false to review the UI locally without Clerk/Stripe keys.
VITE_REQUIRE_AUTH=false

# Plan to inject when VITE_REQUIRE_AUTH=false. Options: free, edge, pro.
VITE_DEV_PLAN=pro
